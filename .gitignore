# 원본 GLB — 재작업용 소스라 로컬에만 둔다 (합쳐서 138MB).
# 게임이 실제로 읽는 건 assets/models/*.opt.glb (3.4MB) 뿐이고,
# 다시 구우려면 tools/optimize-glb.mjs 를 쓴다.
assets/models/source/

# 배경음악 원본 mp4 (4.1MB, 영상 트랙 포함). 게임이 읽는 건 인코딩본 assets/sound/bgm.mp3 (3.0MB) 뿐이고,
# 다시 구우려면 tools/build-bgm.mjs 를 쓴다.
assets/sound/source/music/

# 최적화 스크립트 의존성
node_modules/
package-lock.json

# OS / 에디터
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
